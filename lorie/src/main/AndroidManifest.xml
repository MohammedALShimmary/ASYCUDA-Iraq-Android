<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <permission
        android:name="iq.asycuda.PERMISSION_INTERNAL_BROADCAST"
        android:protectionLevel="signature" />
    <uses-permission android:name="iq.asycuda.PERMISSION_INTERNAL_BROADCAST" />

    <application
        android:name=".LorieApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="true"
        tools:ignore="DataExtractionRules,GoogleAppIndexingWarning">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity=".MainActivity"
            android:icon="@drawable/ic_asycuda_logo"
            android:roundIcon="@drawable/ic_asycuda_logo"
            android:label="@string/lorie_app_name"
            android:theme="@style/LorieAppTheme"
            android:launchMode="singleInstance"
            android:supportsPictureInPicture="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.SECONDARY_HOME" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/lorie_shortcuts" />
        </activity>
        <activity
            android:name=".MainActivity$MainActivityTagged"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity=""
            android:theme="@style/LorieAppTheme"
            android:documentLaunchMode="intoExisting"
            android:supportsPictureInPicture="true"
            android:autoRemoveFromRecents="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:exported="false" />
        <activity
            android:theme="@style/Theme.AppCompat.DayNight"
            android:excludeFromRecents="true"
            android:name=".LoriePreferences"
            android:taskAffinity=".LoriePreferences"
            android:supportsPictureInPicture="false"
            android:resizeableActivity="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
        </activity>
        <meta-data android:name="android.allow_multiple_resumed_activities" android:value="true" />

        <service
            android:name=".AsycudaKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the active customs declaration RMI/TCP session and embedded X11 display engine alive while the user views or shares exported PDF documents." />
        </service>

        <receiver android:name=".LoriePreferences$Receiver" android:exported="false" android:enabled="true">
            <intent-filter>
                <action android:name="com.termux.x11.CHANGE_PREFERENCE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".LorieApp$Receiver" android:exported="false" android:enabled="true">
            <intent-filter>
                <action android:name="com.termux.x11.CmdEntryPoint.ACTION_START" />
                <action android:name="com.termux.x11.ACTION_STOP" />
                <action android:name="com.termux.x11.ACTION_PREFERENCES_CHANGED" />
                <action android:name="com.termux.x11.ACTION_CUSTOM" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="iq.asycuda.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/asycuda_file_paths" />
        </provider>
    </application>
</manifest>
