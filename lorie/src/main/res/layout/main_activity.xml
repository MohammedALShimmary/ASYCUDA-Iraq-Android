<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:paddingLeft="0dp"
        android:paddingTop="0dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp"
        android:background="@android:color/black">

        <com.termux.x11.LorieView
            android:id="@+id/lorieView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:id="@+id/x11_image"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_x11_icon"
                android:contentDescription="AsyLauncher Logo"
                tools:ignore="HardcodedText" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="20dp" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:text="@string/not_connected"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="20dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/preferences_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_extra_key_settings"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/preferences_button_text" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/displays_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/lorie_ic_displays"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/displays_button_text" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/help_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/lorie_ic_help"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/help_button_text" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/exit_button"
                    style="@style/Widget.AppCompat.Button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/lorie_ic_exit"
                    android:tint="?attr/colorControlNormal"
                    android:contentDescription="@string/exit_button_text" />
            </LinearLayout>
        </LinearLayout>


    </FrameLayout>

    <LinearLayout
        android:id="@+id/mouse_helper_visibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:translationX="0px"
        android:translationY="0px">

        <Button
            android:id="@+id/button_visibility"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:minWidth="34dp"
            android:minHeight="34dp"
            android:layout_margin="2dp"
            android:padding="0px"
            android:text="✕"
            android:textStyle="bold"
            android:textColor="#F87171"
            android:background="@drawable/mouse_buttons"
            android:textSize="11sp"
            tools:ignore="HardcodedText,PxUsage,SmallSp" />

        <LinearLayout
            android:id="@+id/mouse_helper_secondary_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:visibility="visible">

            <Button
                android:id="@+id/button_left_click"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:minWidth="38dp"
                android:minHeight="34dp"
                android:layout_margin="2dp"
                android:padding="0px"
                android:text="L"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:background="@drawable/mouse_buttons"
                android:textSize="11sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/button_middle_click"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:minWidth="36dp"
                android:minHeight="34dp"
                android:layout_margin="2dp"
                android:padding="0px"
                android:text="M"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/mouse_buttons"
                android:textSize="11sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/button_right_click"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:minWidth="38dp"
                android:minHeight="34dp"
                android:layout_margin="2dp"
                android:padding="0px"
                android:text="R"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:background="@drawable/mouse_buttons"
                android:textSize="11sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mouse_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="5dp"
        android:alpha="0.95"
        android:elevation="14dp"
        android:translationX="0px"
        android:translationY="0px">

        <LinearLayout
            android:id="@+id/mouse_buttons_secondary_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:visibility="visible">

            <Button
                android:id="@+id/mouse_button_left_click"
                android:layout_width="70dp"
                android:layout_height="38dp"
                android:minWidth="42dp"
                android:minHeight="38dp"
                android:layout_margin="2dp"
                android:padding="0px"
                android:text="L"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:background="@drawable/mouse_buttons"
                android:textSize="12sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/mouse_button_middle_click"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:minWidth="42dp"
                android:minHeight="38dp"
                android:layout_margin="2dp"
                android:padding="0px"
                android:text="M"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/mouse_buttons"
                android:textSize="11.5sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/mouse_button_right_click"
                android:layout_width="70dp"
                android:layout_height="38dp"
                android:minWidth="42dp"
                android:minHeight="38dp"
                android:layout_margin="2dp"
                android:padding="0px"
                android:text="R"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:background="@drawable/mouse_buttons"
                android:textSize="12sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mouse_buttons_position"
            android:layout_width="38dp"
            android:layout_height="28dp"
            android:minWidth="38dp"
            android:minHeight="28dp"
            android:layout_margin="2dp"
            android:adjustViewBounds="true"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mouse_deck_grip"
            android:contentDescription="Drag or Rotate Mouse Buttons"
            android:layout_gravity="center"
            android:background="@drawable/mouse_buttons"
            tools:ignore="HardcodedText,PxUsage,SmallSp" />
    </LinearLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/terminal_toolbar_view_pager"
        android:visibility="gone"
        android:pointerIcon="arrow"
        android:layout_width="match_parent"
        android:layout_height="37.5dp"
        android:background="@android:color/black"
        android:layoutDirection="ltr"
        android:layout_gravity="bottom|center"/>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:layout_gravity="bottom|center" />
</FrameLayout>
